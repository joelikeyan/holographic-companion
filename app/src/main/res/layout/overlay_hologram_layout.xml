<?xml version="1.0" encoding="utf-8"?>
<!-- Overlay window layout inflated by HolographicOverlayService.
     Expanded state: the hologram surface. Minimized state: the halo node. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <com.cortana.hologram.HologramSurfaceView
        android:id="@+id/hologram_surface"
        android:layout_width="280dp"
        android:layout_height="420dp" />

    <View
        android:id="@+id/compact_halo_node"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:background="@drawable/halo_ring"
        android:visibility="gone" />
</FrameLayout>
